@page "/settings"
@using CoreAdmin.Models
@using CoreAdmin.Services
@inject SettingsService SettingsService
@inject NotificationService NotificationService
@inject AuthService AuthService
@inject IJSRuntime JSRuntime

<PageTitle>Configuración Global</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold mb-0" style="color: var(--fedora-dark);">Configuración</h1>
</div>

@if (AuthService.CurrentUser?.IdRol != 0)
{
    <div class="d-flex flex-column align-items-center justify-content-center py-5 shadow-sm rounded-4 bg-white border" style="min-height: 60vh;">
        <div class="text-warning mb-4">
            <i class="bi bi-gear-wide-connected" style="font-size: 5rem; opacity: 0.2;"></i>
        </div>
        <h3 class="fw-bold text-dark">Configuración Restringida</h3>
        <p class="text-muted text-center max-w-400">
            Los ajustes globales del sistema y la gestión de membresías están reservados para administradores.
        </p>
        <button class="btn btn-primary mt-3 px-4 rounded-pill shadow-sm" @onclick='() => JSRuntime.InvokeVoidAsync("history.back")'>
            <i class="bi bi-arrow-left me-2"></i> Volver atrás
        </button>
    </div>
}
else
{
    <div class="row g-4">
        <!-- Planes ABM -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold" style="color: var(--fedora-dark);">Planes y Membresías</h5>
                    <button type="button" class="btn btn-primary btn-sm px-3 fw-medium" @onclick="ShowAddForm"><i class="bi bi-plus-lg me-1"></i> Nuevo Plan</button>
                </div>
                <div class="card-body p-0">
                    @if (showForm)
                    {
                        <div class="p-4 bg-light border-bottom border-primary border-opacity-25" style="border-left: 4px solid var(--bs-primary);">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="mb-0 fw-bold text-primary">
                                    @(isEditing ? $"Editando Plan: {editingPlan.PlanNombre} (ID: #{editingPlan.IdPlan})" : "Nuevo Plan de Membresía")
                                </h6>
                            </div>
                            <EditForm @key="editingPlan" Model="editingPlan" OnValidSubmit="SavePlan">
                                <DataAnnotationsValidator />
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-5">
                                        <label class="form-label small text-muted fw-bold">Nombre de la Cuota</label>
                                        <InputText class="form-control border-0 shadow-sm" @bind-Value="editingPlan.PlanNombre" required placeholder="Ej. Semestral" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small text-muted fw-bold">Importe Fijo ($)</label>
                                        <InputNumber class="form-control border-0 shadow-sm text-success fw-bold" @bind-Value="editingPlan.Precio" required />
                                    </div>
                                    <div class="col-md-3 d-flex gap-2">
                                        <button type="submit" class="btn btn-success w-100 shadow-sm fw-bold"><i class="bi bi-check-lg me-1"></i> Guardar</button>
                                        <button type="button" class="btn btn-light shadow-sm text-secondary border" @onclick="() => showForm = false"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <ValidationSummary class="text-danger small" />
                                </div>
                            </EditForm>
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4 py-3 text-muted border-bottom-0">Plan</th>
                                    <th class="py-3 text-muted text-end border-bottom-0">Precio Vigente</th>
                                    <th class="pe-4 py-3 text-end text-muted border-bottom-0">Gestión</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in planes)
                                {
                                    <tr @key="p.IdPlan">
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex justify-content-center align-items-center me-3" style="width:35px; height:35px;">
                                                    <i class="bi bi-ticket-detailed-fill"></i>
                                                </div>
                                                <div>
                                                    <span class="fw-bold text-dark d-block">@p.PlanNombre</span>
                                                    <span class="text-muted small">DB_ID: #@p.IdPlan</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-end align-middle">
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success fw-bold fs-6 tracking-wide px-3 py-2">
                                                $@p.Precio.ToString("N2")
                                            </span>
                                        </td>
                                        <td class="text-end pe-4 align-middle">
                                            <button class="btn btn-sm btn-light text-primary me-2 border shadow-sm" @onclick="() => EditPlan(p)"><i class="bi bi-pencil"></i></button>
                                            <button class="btn btn-sm btn-light text-danger border shadow-sm" @onclick="() => DeletePlan(p.IdPlan)"><i class="bi bi-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                                @if (!planes.Any() && !isLoading)
                                {
                                    <tr><td colspan="3" class="text-center py-5 text-muted">No existen planes registrados.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Backup Module -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100" style="background-color: #ffffff;">
                <div class="card-body p-4 text-center d-flex flex-column justify-content-center">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="bi bi-shield-check fs-1"></i>
                    </div>
                    <h4 class="fw-bold mb-2" style="color: var(--fedora-dark);">Seguridad de Datos</h4>
                    <p class="text-muted small mb-4">Genera una copia de seguridad local de toda tu base de datos (clientes, pagos y configuraciones).</p>
                    
                    <button class="btn btn-dark w-100 py-3 fw-bold mb-3" @onclick="StartBackup" disabled="@isBackingUp" style="background-color: var(--fedora-sidebar);">
                        @{
                            if (isBackingUp)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span><span>Procesando...</span>
                            }
                            else
                            {
                                <i class="bi bi-cloud-download me-2"></i><span>Crear Respaldo</span>
                            }
                        }
                    </button>
                    
                    @if (!string.IsNullOrEmpty(backupResult))
                    {
                        <div class="p-3 rounded-3 small @(backupResult.StartsWith("Error") ? "bg-danger-subtle text-danger" : "bg-success-subtle text-success")">
                            @backupResult
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Alarmas y Notificaciones -->
        <div class="col-lg-12 mt-4 mb-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold" style="color: var(--fedora-dark);">Canales de Comunicación</h5>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-primary btn-sm px-3 fw-medium" @onclick="TestWhatsApp" disabled="@(!notifConfig.WaActivo)">
                            WhatsApp
                        </button>
                        <button class="btn btn-outline-primary btn-sm px-3 fw-medium" @onclick="TestEmail" disabled="@(!notifConfig.EmailActivo)">
                            Email
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <!-- WhatsApp Evolution API -->
                        <div class="col-md-6 border-end border-light">
                            <h6 class="fw-bold mb-3 text-success"><i class="bi bi-whatsapp me-2"></i>WhatsApp (Evolution API)</h6>
                            <div class="mb-3">
                                <label class="form-label small text-muted fw-bold">URL de la API</label>
                                <input type="text" class="form-control border-0 bg-light shadow-none" @bind="notifConfig.WaApiUrl" placeholder="https://api.tu-servidor.com" />
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label small text-muted fw-bold">Instancia</label>
                                    <input type="text" class="form-control border-0 bg-light shadow-none" @bind="notifConfig.WaInstance" placeholder="Main" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small text-muted fw-bold">API Key / Token</label>
                                    <input type="password" class="form-control border-0 bg-light shadow-none" @bind="notifConfig.WaToken" />
                                </div>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="waActiveSwitch" @bind="notifConfig.WaActivo">
                                <label class="form-check-label small fw-bold text-muted" for="waActiveSwitch">Habilitar envíos por WhatsApp</label>
                            </div>
                        </div>

                        <!-- Email SMTP -->
                        <div class="col-md-6">
                            <h6 class="fw-bold mb-3 text-info"><i class="bi bi-envelope me-2"></i>Correo Electrónico (SMTP)</h6>
                            <div class="row g-2 mb-3">
                                <div class="col-9">
                                    <label class="form-label small text-muted fw-bold">Servidor SMTP</label>
                                    <input type="text" class="form-control border-0 bg-light shadow-none" @bind="notifConfig.SmtpHost" placeholder="smtp.gmail.com" />
                                </div>
                                <div class="col-3">
                                    <label class="form-label small text-muted fw-bold">Puerto</label>
                                    <input type="number" class="form-control border-0 bg-light shadow-none" @bind="notifConfig.SmtpPort" />
                                </div>
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label small text-muted fw-bold">Usuario / Email</label>
                                    <input type="text" class="form-control border-0 bg-light shadow-none" @bind="notifConfig.SmtpUser" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small text-muted fw-bold">Contraseña</label>
                                    <input type="password" class="form-control border-0 bg-light shadow-none" @bind="notifConfig.SmtpPassword" />
                                </div>
                            </div>
                            <div class="d-flex gap-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="emailActiveSwitch" @bind="notifConfig.EmailActivo">
                                    <label class="form-check-label small fw-bold text-muted" for="emailActiveSwitch">Habilitar Email</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="sslSwitch" @bind="notifConfig.SmtpSsl">
                                    <label class="form-check-label small fw-bold text-muted" for="sslSwitch">SSL/TLS</label>
                                </div>
                            </div>
                        </div>

                        <!-- Template Global -->
                        <div class="col-12 border-top border-light pt-4">
                            <h6 class="fw-bold mb-2 text-dark"><i class="bi bi-chat-left-dots me-2"></i>Plantilla del Mensaje de Vencimiento</h6>
                            <p class="text-muted small mb-3">Usa etiquetas: <code>{nombre}</code>, <code>{apellido}</code>, <code>{fecha}</code></p>
                            <textarea class="form-control border-0 bg-light shadow-none" rows="3" @bind="notifConfig.MensajeTemplate"></textarea>
                            
                            <div class="mt-4 d-flex justify-content-end">
                                <button class="btn btn-warning px-5 shadow-sm fw-bold" @onclick="SaveNotificationConfig">
                                    <i class="bi bi-save2 me-2"></i> Guardar Configuración de Alertas
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Planes> planes = new();
    private PrinterSettings printerSettings = new();
    private NotificacionConfig notifConfig = new();
    private bool isLoading = true;
    private bool showForm = false;
    private bool isEditing = false;
    private Planes editingPlan = new();
    
    private bool isBackingUp = false;
    private string backupResult = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadPlanes();
        printerSettings = await SettingsService.GetPrinterSettingsAsync();
        notifConfig = await NotificationService.GetConfigAsync();
    }

    private async Task SavePrinterSettings()
    {
        await SettingsService.UpdatePrinterSettingsAsync(printerSettings);
        await JSRuntime.InvokeVoidAsync("alert", "Configuración de impresora guardada correctamente.");
    }

    private async Task LoadPlanes()
    {
        isLoading = true;
        StateHasChanged();
        planes = await SettingsService.GetPlanesAsync();
        isLoading = false;
        StateHasChanged();
    }

    private void ShowAddForm()
    {
        editingPlan = new Planes();
        isEditing = false;
        showForm = true;
        StateHasChanged();
    }

    private void EditPlan(Planes p)
    {
        // Forzamos la creación de un nuevo objeto pero manteniendo el ID exacto
        editingPlan = new Planes
        {
            IdPlan = p.IdPlan,
            PlanNombre = p.PlanNombre,
            Precio = p.Precio
        };
        isEditing = true;
        showForm = true;
        StateHasChanged();
    }

    private async Task SavePlan()
    {
        try 
        {
            await SettingsService.SavePlanAsync(editingPlan);
            showForm = false;
            await LoadPlanes();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", ex.Message);
        }
    }

    private async Task DeletePlan(int id)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "¿Eliminar este plan permanentemente? Advertencia: Los clientes actuales que tengan este plan podrían experimentar errores en los reportes financieros si este ID se borra de la tabla maestra.");
        if (confirmed)
        {
            try 
            {
                await SettingsService.DeletePlanAsync(id);
                await LoadPlanes();
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", ex.Message);
            }
        }
    }
    
    private async Task StartBackup()
    {
        isBackingUp = true;
        backupResult = "";
        StateHasChanged();
        
        await Task.Delay(1250); // Feedback visual premium
        string result = SettingsService.CreateBackup();
        
        if(result.StartsWith("Error"))
        {
            backupResult = result;
        }
        else
        {
            backupResult = $"¡Respaldado Exitoso! Guardado en: {result}";
        }
        
        isBackingUp = false;
        StateHasChanged();
    }

    private async Task SaveNotificationConfig()
    {
        await NotificationService.SaveConfigAsync(notifConfig);
        await JSRuntime.InvokeVoidAsync("alert", "Configuración de notificaciones guardada.");
    }

    private async Task TestWhatsApp()
    {
        var tel = await JSRuntime.InvokeAsync<string>("prompt", "Ingresa un número de WhatsApp para la prueba (con código de país, ej: 54911...)");
        if (string.IsNullOrEmpty(tel)) return;

        var dummy = new Cliente { Nombre = "Test", Apellido = "User", Telefono = tel, FechaVencimiento = DateTime.Now.AddDays(3) };
        var ok = await NotificationService.SendWhatsAppAsync(dummy, notifConfig);
        await JSRuntime.InvokeVoidAsync("alert", ok ? "Mensaje de prueba enviado con éxito." : "Error al enviar mensaje. Revisa la URL/Token/Instancia.");
    }

    private async Task TestEmail()
    {
        var email = await JSRuntime.InvokeAsync<string>("prompt", "Ingresa un correo para la prueba:");
        if (string.IsNullOrEmpty(email)) return;

        var dummy = new Cliente { Nombre = "Test", Apellido = "User", Email = email, FechaVencimiento = DateTime.Now.AddDays(3) };
        var ok = await NotificationService.SendEmailAsync(dummy, notifConfig);
        await JSRuntime.InvokeVoidAsync("alert", ok ? "Correo de prueba enviado con éxito." : "Error al enviar correo. Revisa el host/user/pass.");
    }
}
