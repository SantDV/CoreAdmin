@page "/inventory"
@using CoreAdmin.Models
@using CoreAdmin.Services
@inject InventoryService InventoryService
@inject AuthService AuthService
@inject IJSRuntime JS

<PageTitle>Inventario y Productos</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0 text-dark">
            <i class="bi bi-box-seam text-primary me-2"></i> Gestión de Inventario
        </h2>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-dark" @onclick="() => showCategoryModal = true">
                <i class="bi bi-tags me-1"></i> Categorías
            </button>
            <button class="btn btn-primary shadow-sm" @onclick="() => OpenProductModal()">
                <i class="bi bi-plus-lg me-1"></i> Nuevo Producto
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" class="form-control border-start-0 ps-0" 
                               placeholder="Buscar por nombre o código..." 
                               @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleSearch" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select shadow-sm" @bind="selectedCategoryId">
                        <option value="">Todas las categorías</option>
                        @foreach (var cat in categorias)
                        {
                            <option value="@cat.IdCategoria">@cat.NombreCategoria</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-dark w-100" @onclick="LoadProductos">
                        <i class="bi bi-funnel me-1"></i> Filtrar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Product Grid/Table -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase fw-bold">
                    <tr>
                        <th class="ps-4 py-3">Código</th>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th class="text-end">P. Compra</th>
                        <th class="text-end">P. Venta</th>
                        <th class="text-center">Stock</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr><td colspan="7" class="text-center py-5">Cargando productos...</td></tr>
                    }
                    else if (!productos.Any())
                    {
                        <tr><td colspan="7" class="text-center py-5">No se encontraron productos.</td></tr>
                    }
                    else
                    {
                        @foreach (var p in productos)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1">
                                        @p.Codigo
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold">@p.Nombre</div>
                                    <div class="small text-muted">@p.Descripcion</div>
                                </td>
                                <td>@p.NombreCategoria</td>
                                <td class="text-end text-muted small">$@p.PrecioCompra.ToString("N2")</td>
                                <td class="text-end fw-bold text-dark">$@p.PrecioVenta.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge @(p.Stock <= p.StockMinimo ? "bg-danger" : "bg-success") rounded-pill px-3">
                                        @p.Stock
                                    </span>
                                    @if (p.Stock <= p.StockMinimo)
                                    {
                                        <div class="text-danger" style="font-size: 0.7rem;">Stock Bajo</div>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-primary me-1" title="Editar" @onclick="() => OpenProductModal(p)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-info me-1" title="Ajustar Stock" @onclick="() => OpenStockModal(p)">
                                        <i class="bi bi-boxes"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" title="Eliminar" @onclick="() => ConfirmDelete(p)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Producto -->
@if (showProductModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-bottom-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold">@(editingProduct.IdProducto == 0 ? "Nuevo Producto" : "Editar Producto")</h5>
                    <button type="button" class="btn-close" @onclick="() => showProductModal = false"></button>
                </div>
                <div class="modal-body px-4 pb-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Código</label>
                            <input type="text" class="form-control" @bind="editingProduct.Codigo" placeholder="SKU-001" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Nombre</label>
                            <input type="text" class="form-control" @bind="editingProduct.Nombre" placeholder="Nombre de producto" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Descripción</label>
                            <textarea class="form-control" @bind="editingProduct.Descripcion" rows="2"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Categoría</label>
                            <select class="form-select" @bind="editingProduct.IdCategoria">
                                <option value="0">Seleccionar...</option>
                                @foreach (var cat in categorias)
                                {
                                    <option value="@cat.IdCategoria">@cat.NombreCategoria</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">Precio Compra</label>
                            <input type="number" class="form-control" @bind="editingProduct.PrecioCompra" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">Precio Venta</label>
                            <input type="number" class="form-control" @bind="editingProduct.PrecioVenta" />
                        </div>
                        @if (editingProduct.IdProducto == 0)
                        {
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Stock Inicial</label>
                                <input type="number" class="form-control" @bind="editingProduct.Stock" />
                            </div>
                        }
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Stock Mínimo</label>
                            <input type="number" class="form-control" @bind="editingProduct.StockMinimo" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 px-4 pb-4">
                    <button class="btn btn-light rounded-3 px-4" @onclick="() => showProductModal = false">Cancelar</button>
                    <button class="btn btn-primary rounded-3 px-4" @onclick="SaveProducto">Guardar Producto</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Stock Adjustment -->
@if (showStockModal && selectedProduct != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-bottom-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold">Ajustar Stock: @selectedProduct.Nombre</h5>
                    <button type="button" class="btn-close" @onclick="() => showStockModal = false"></button>
                </div>
                <div class="modal-body px-4 pb-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Stock Actual</label>
                        <input type="text" class="form-control bg-light" value="@selectedProduct.Stock" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Cantidad a ajustar (usa negativo para quitar)</label>
                        <input type="number" class="form-control" @bind="stockAdjustment" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Motivo</label>
                        <input type="text" class="form-control" @bind="adjustmentReason" placeholder="Ej: Compra a proveedor, rotura, etc." />
                    </div>
                </div>
                <div class="modal-footer border-top-0 px-4 pb-4">
                    <button class="btn btn-light rounded-3 px-4" @onclick="() => showStockModal = false">Cancelar</button>
                    <button class="btn btn-info text-white rounded-3 px-4" @onclick="SaveStockAdjustment">Realizar Ajuste</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Categorías -->
@if (showCategoryModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-bottom-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold">Gestión de Categorías</h5>
                    <button type="button" class="btn-close" @onclick="() => showCategoryModal = false"></button>
                </div>
                <div class="modal-body px-4 pb-4">
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" placeholder="Nueva categoría..." @bind="newCategoryName" />
                        <button class="btn btn-primary" @onclick="AddCategoria">Agregar</button>
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var c in categorias)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                @c.NombreCategoria
                                <button class="btn btn-sm text-danger" @onclick="() => DeleteCategoria(c.IdCategoria)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Producto> productos = new();
    private List<CategoriaProducto> categorias = new();
    private bool isLoading = true;
    private string searchTerm = "";
    private int? selectedCategoryId = null;

    private bool showProductModal = false;
    private bool showStockModal = false;
    private bool showCategoryModal = false;

    private Producto editingProduct = new();
    private Producto? selectedProduct;
    private int stockAdjustment = 0;
    private string adjustmentReason = "";
    private string newCategoryName = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadCategorias();
        await LoadProductos();
    }

    private async Task LoadCategorias()
    {
        categorias = await InventoryService.GetCategoriasAsync();
    }

    private async Task LoadProductos()
    {
        isLoading = true;
        productos = await InventoryService.GetProductosAsync(searchTerm, selectedCategoryId == 0 ? null : selectedCategoryId);
        isLoading = false;
    }

    private async Task HandleSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadProductos();
    }

    private void OpenProductModal(Producto? p = null)
    {
        if (p == null)
        {
            editingProduct = new Producto { IdCategoria = categorias.FirstOrDefault()?.IdCategoria ?? 0 };
        }
        else
        {
            // Simple clone
            editingProduct = new Producto {
                IdProducto = p.IdProducto,
                Codigo = p.Codigo,
                Nombre = p.Nombre,
                Descripcion = p.Descripcion,
                IdCategoria = p.IdCategoria,
                PrecioCompra = p.PrecioCompra,
                PrecioVenta = p.PrecioVenta,
                StockMinimo = p.StockMinimo,
                Stock = p.Stock
            };
        }
        showProductModal = true;
    }

    private async Task SaveProducto()
    {
        if (string.IsNullOrEmpty(editingProduct.Nombre) || editingProduct.IdCategoria == 0)
        {
            await JS.InvokeVoidAsync("alert", "Nombre y Categoría son obligatorios.");
            return;
        }

        if (editingProduct.IdProducto == 0)
            await InventoryService.AddProductoAsync(editingProduct, AuthService.CurrentUser?.IdUsuario ?? 1);
        else
            await InventoryService.UpdateProductoAsync(editingProduct);

        showProductModal = false;
        await LoadProductos();
    }

    private void OpenStockModal(Producto p)
    {
        selectedProduct = p;
        stockAdjustment = 0;
        adjustmentReason = "";
        showStockModal = true;
    }

    private async Task SaveStockAdjustment()
    {
        if (selectedProduct == null || stockAdjustment == 0) return;

        try {
            await InventoryService.AjustarStockAsync(selectedProduct.IdProducto, stockAdjustment, adjustmentReason, AuthService.CurrentUser?.IdUsuario ?? 1);
            showStockModal = false;
            await LoadProductos();
        } catch (Exception ex) {
            await JS.InvokeVoidAsync("alert", ex.Message);
        }
    }

    private async Task ConfirmDelete(Producto p)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"¿Eliminar producto '{p.Nombre}'?");
        if (confirm)
        {
            await InventoryService.DeleteProductoAsync(p.IdProducto);
            await LoadProductos();
        }
    }

    private async Task AddCategoria()
    {
        if (string.IsNullOrWhiteSpace(newCategoryName)) return;
        await InventoryService.AddCategoriaAsync(new CategoriaProducto { NombreCategoria = newCategoryName });
        newCategoryName = "";
        await LoadCategorias();
    }

    private async Task DeleteCategoria(int id)
    {
        await InventoryService.DeleteCategoriaAsync(id);
        await LoadCategorias();
    }
}
