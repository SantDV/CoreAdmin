@page "/"
@using GymDashboard.Models
@using GymDashboard.Services
@inject ClienteService ClienteService

<PageTitle>Dashboard</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Resumen General del Gimnasio</h2>
    <span class="text-muted"><i class="bi bi-calendar-event me-2"></i> @DateTime.Now.ToString("dd MMMM yyyy")</span>
</div>

@if (isLoading)
{
    <div class="d-flex flex-column justify-content-center align-items-center py-5" style="min-height: 50vh;">
        <div class="spinner-border text-primary opacity-75" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <h5 class="mt-4 text-muted fw-normal">Analizando estadísticas...</h5>
    </div>
}
else if (stats != null)
{
    <!-- Kpis Row 1 -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted fw-semibold mb-1">Activos</h6>
                            <h2 class="mb-0 fw-bold text-success">@stats.ClientesActivos</h2>
                        </div>
                        <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                            <i class="bi bi-people-fill fs-4"></i>
                        </div>
                    </div>
                    <div class="mt-3 small text-muted">
                        De un total de @stats.TotalClientes registrados
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-warning border-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted fw-semibold mb-1">Por Vencer (7 días)</h6>
                            <h2 class="mb-0 fw-bold text-warning">@stats.PlanesPorVencer</h2>
                        </div>
                        <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle">
                            <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-danger border-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted fw-semibold mb-1">Planes Vencidos</h6>
                            <h2 class="mb-0 fw-bold text-danger">@stats.PlanesVencidos</h2>
                        </div>
                        <div class="bg-danger bg-opacity-10 text-danger p-3 rounded-circle">
                            <i class="bi bi-x-circle-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted fw-semibold mb-1">Nuevos este mes</h6>
                            <h2 class="mb-0 fw-bold text-primary">@stats.RegistrosMes</h2>
                        </div>
                        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                            <i class="bi bi-graph-up-arrow fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Analytics & Activity Row -->
    <div class="row g-4">
        <!-- Detalles de Registro -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-bar-chart me-2 text-primary"></i> Ritmo de Registros</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted">Nuevos Hoy</span>
                            <span class="badge bg-primary rounded-pill px-3 py-2 fs-6">@stats.RegistrosHoy</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted">Nuevos esta Semana</span>
                            <span class="badge bg-primary rounded-pill px-3 py-2 fs-6">@stats.RegistrosSemana</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted">Nuevos este Mes</span>
                            <span class="badge bg-primary rounded-pill px-3 py-2 fs-6">@stats.RegistrosMes</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted">Nuevos este Año</span>
                            <span class="badge bg-primary rounded-pill px-3 py-2 fs-6">@stats.RegistrosAnio</span>
                        </li>
                         <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted">Clientes Inactivos</span>
                            <span class="badge bg-secondary rounded-pill px-3 py-2 fs-6">@stats.ClientesInactivos</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Próximos Vencimientos -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-clock-history me-2 text-warning"></i> Próximos Vencimientos (7 días)</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Cliente</th>
                                    <th>Teléfono</th>
                                    <th>Email</th>
                                    <th>Fecha Vencimiento</th>
                                </tr>
                            </thead>
                            <tbody class="border-top-0">
                                @if (clientesPorVencer.Any())
                                {
                                    @foreach (var c in clientesPorVencer)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <span class="fw-semibold text-dark">@c.Nombre @c.Apellido</span>
                                            </td>
                                            <td><span class="text-muted">@(string.IsNullOrEmpty(c.Telefono) ? "-" : c.Telefono)</span></td>
                                            <td><span class="text-muted">@(string.IsNullOrEmpty(c.Email) ? "-" : c.Email)</span></td>
                                            <td>
                                                <span class="badge bg-warning text-dark fw-normal px-2 py-1">
                                                    @(c.FechaVencimiento?.ToString("dd MMM yyyy"))
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5 text-muted">
                                            <i class="bi bi-check-circle fs-1 text-success d-block mb-3"></i>
                                            No hay planes próximos a vencer esta semana.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DashboardStats? stats;
    private List<Cliente> clientesPorVencer = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        stats = await ClienteService.GetDashboardStatsAsync();
        clientesPorVencer = await ClienteService.GetClientesPorVencerAsync();
        isLoading = false;
    }
}
