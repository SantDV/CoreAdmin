@page "/"
@using CoreAdmin.Models
@using CoreAdmin.Services
@inject ClienteService ClienteService
@inject NotificationService NotificationService
@inject IJSRuntime JSRuntime

<PageTitle>Dashboard</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Resumen General del Gimnasio</h2>
    <span class="text-muted"><i class="bi bi-calendar-event me-2"></i> @DateTime.Now.ToString("dd MMMM yyyy")</span>
</div>

@if (isLoading)
{
    <div class="d-flex flex-column justify-content-center align-items-center py-5" style="min-height: 50vh;">
        <div class="spinner-border text-primary opacity-75" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <h5 class="mt-4 text-muted fw-normal">Analizando estadísticas...</h5>
    </div>
}
else if (stats != null)
{
    <!-- Kpis Row 1 -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted fw-semibold mb-1">Activos</h6>
                            <h2 class="mb-0 fw-bold text-success">@stats.ClientesActivos</h2>
                        </div>
                        <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                            <i class="bi bi-people-fill fs-4"></i>
                        </div>
                    </div>
                    <div class="mt-3 small text-muted">
                        De un total de @stats.TotalClientes registrados
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-warning border-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted fw-semibold mb-1">Por Vencer (7 días)</h6>
                            <h2 class="mb-0 fw-bold text-warning">@stats.PlanesPorVencer</h2>
                        </div>
                        <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle">
                            <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-danger border-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted fw-semibold mb-1">Planes Vencidos</h6>
                            <h2 class="mb-0 fw-bold text-danger">@stats.PlanesVencidos</h2>
                        </div>
                        <div class="bg-danger bg-opacity-10 text-danger p-3 rounded-circle">
                            <i class="bi bi-x-circle-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted fw-semibold mb-1">Nuevos este mes</h6>
                            <h2 class="mb-0 fw-bold text-primary">@stats.RegistrosMes</h2>
                        </div>
                        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                            <i class="bi bi-graph-up-arrow fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Financial Row -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-success text-white">
                <div class="card-body py-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 fw-semibold mb-1">Ingresos del Mes</h6>
                            <h2 class="mb-0 fw-bold">$@stats.IngresosMes.ToString("N2")</h2>
                        </div>
                        <i class="bi bi-cash-stack fs-1 opacity-25"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-danger text-white">
                <div class="card-body py-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 fw-semibold mb-1">Egresos del Mes</h6>
                            <h2 class="mb-0 fw-bold">$@stats.EgresosMes.ToString("N2")</h2>
                        </div>
                        <i class="bi bi-cart-dash fs-1 opacity-25"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 @(stats.BalanceMes >= 0 ? "bg-primary" : "bg-dark") text-white">
                <div class="card-body py-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 fw-semibold mb-1">Balance Neto</h6>
                            <h2 class="mb-0 fw-bold">$@stats.BalanceMes.ToString("N2")</h2>
                        </div>
                        <i class="bi bi-bank fs-1 opacity-25"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Analytics & Activity Row -->
    <div class="row g-4">
        <!-- Detalles de Registro -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-bar-chart me-2 text-primary"></i> Ritmo de Registros</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted">Nuevos Hoy</span>
                            <span class="badge bg-primary rounded-pill px-3 py-2 fs-6">@stats.RegistrosHoy</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted">Nuevos esta Semana</span>
                            <span class="badge bg-primary rounded-pill px-3 py-2 fs-6">@stats.RegistrosSemana</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted">Nuevos este Mes</span>
                            <span class="badge bg-primary rounded-pill px-3 py-2 fs-6">@stats.RegistrosMes</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted">Nuevos este Año</span>
                            <span class="badge bg-primary rounded-pill px-3 py-2 fs-6">@stats.RegistrosAnio</span>
                        </li>
                         <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted">Clientes Inactivos</span>
                            <span class="badge bg-secondary rounded-pill px-3 py-2 fs-6">@stats.ClientesInactivos</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Próximos Vencimientos -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-clock-history me-2 text-warning"></i> Próximos Vencimientos (7 días)</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Cliente</th>
                                    <th>Teléfono</th>
                                    <th>Email</th>
                                    <th>Fecha Vencimiento</th>
                                    <th class="text-center pe-4">Notificación</th>
                                </tr>
                            </thead>
                            <tbody class="border-top-0">
                                @if (clientesPorVencer.Any())
                                {
                                    @foreach (var c in clientesPorVencer)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <span class="fw-semibold text-dark">@c.Nombre @c.Apellido</span>
                                            </td>
                                            <td><span class="text-muted">@(string.IsNullOrEmpty(c.Telefono) ? "-" : c.Telefono)</span></td>
                                            <td><span class="text-muted">@(string.IsNullOrEmpty(c.Email) ? "-" : c.Email)</span></td>
                                            <td>
                                                <span class="badge bg-warning text-dark fw-normal px-2 py-1">
                                                    @(c.FechaVencimiento?.ToString("dd MMM yyyy"))
                                                </span>
                                            </td>
                                            <td class="text-center pe-4">
                                                @{
                                                    var hist = historial.FirstOrDefault(h => h.IdCliente == c.IdCliente && h.FechaVencimientoAviso == c.FechaVencimiento?.ToString("yyyy-MM-dd"));
                                                }
                                                @if (hist != null)
                                                {
                                                    <span class="badge @(hist.Estado == 1 ? "bg-success" : "bg-danger") rounded-pill" title="Enviado el @hist.FechaEnvio.ToString("dd/MM HH:mm")">
                                                        <i class="bi @(hist.Medio == "WA" ? "bi-whatsapp" : "bi-envelope") me-1"></i> @(hist.Estado == 1 ? "Enviado" : "Error")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <div class="btn-group btn-group-sm">
                                                        <button class="btn btn-outline-success" @onclick='@(() => NotificarManual(c, "WA"))' title="Enviar WhatsApp">
                                                            <i class="bi bi-whatsapp"></i>
                                                        </button>
                                                        <button class="btn btn-outline-info" @onclick='@(() => NotificarManual(c, "EMAIL"))' title="Enviar Email">
                                                            <i class="bi bi-envelope"></i>
                                                        </button>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5 text-muted">
                                            <i class="bi bi-check-circle fs-1 text-success d-block mb-3"></i>
                                            No hay planes próximos a vencer esta semana.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DashboardStats? stats;
    private List<Cliente> clientesPorVencer = new();
    private List<NotificacionHistorial> historial = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        stats = await ClienteService.GetDashboardStatsAsync();
        clientesPorVencer = await ClienteService.GetClientesPorVencerAsync();
        historial = await NotificationService.GetHistorialRecienteAsync(100);
        isLoading = false;
    }

    private async Task NotificarManual(Cliente c, string medio)
    {
        var config = await NotificationService.GetConfigAsync();
        bool success = false;
        
        if (medio == "WA") {
            if (!config.WaActivo) {
                await JSRuntime.InvokeVoidAsync("alert", "WhatsApp no está activo en Ajustes.");
                return;
            }
            success = await NotificationService.SendWhatsAppAsync(c, config);
        } else {
            if (!config.EmailActivo) {
                await JSRuntime.InvokeVoidAsync("alert", "Email no está activo en Ajustes.");
                return;
            }
            success = await NotificationService.SendEmailAsync(c, config);
        }

        if (success) {
            // Registrar en historial si fue exitoso
            // El servicio lo hace automáticamente en CheckAndSend, pero aquí lo haremos manual para que aparezca el badge
            await NotificationService.CheckAndSendExpirationsAsync(); // Esto refresca el historial si coincide con los 3 días, 
                                                                     // pero mejor un método directo.
            historial = await NotificationService.GetHistorialRecienteAsync(100);
            StateHasChanged();
        } else {
            await JSRuntime.InvokeVoidAsync("alert", "Error al enviar la notificación. Verifica la configuración.");
        }
    }
}
