@code {
    private List<Cliente> clientes = new();
    private List<Genero> generos = new();
    private List<Planes> planes = new();
    private bool isLoading = true;
    private bool showForm = false;
    private bool showDetails = false;
    private bool isRenovating = false;
    private Cliente editingCliente = new();
    private Cliente? selectedClient;
    private List<PagoReporte> history = new();
    private int originalEstado;

    private string searchTerm = "";
    private System.Timers.Timer? searchTimer;

    // Paginación
    private int pageSize = 20;
    private int currentPage = 0;
    private bool hasMore = true;

    private bool IsActiveBool
    {
        get => editingCliente.Estado == 1;
        set
        {
            editingCliente.Estado = value ? 1 : 0;
            if (value)
            {
                // Al reactivar, si las fechas son pasadas o no existen, sugerimos hoy
                if (!editingCliente.FechaInicio.HasValue || editingCliente.FechaInicio.Value < DateTime.Now.Date)
                {
                    editingCliente.FechaInicio = DateTime.Now.Date;
                }
                RecalcularVencimiento();
            }
        }
    }

    private int? EditingClienteIdPlan
    {
        get => editingCliente.IdPlan;
        set
        {
            editingCliente.IdPlan = value;
            RecalcularVencimiento();
        }
    }

    private DateTime? EditingClienteFechaInicio
    {
        get => editingCliente.FechaInicio;
        set
        {
            editingCliente.FechaInicio = value;
            RecalcularVencimiento();
        }
    }

    private void RecalcularVencimiento()
    {
        if (editingCliente.FechaInicio.HasValue && editingCliente.IdPlan.HasValue)
        {
            var dias = GetDiasPorPlan(editingCliente.IdPlan);
            editingCliente.FechaVencimiento = editingCliente.FechaInicio.Value.AddDays(dias);
        }
        else
        {
            // Si falta el plan o la fecha de inicio, no podemos calcular el vencimiento automáticamente
            // Podemos dejarlo como está o limpiarlo para forzar al usuario a revisarlo
        }
        StateHasChanged();
    }
    
    private int GetDiasPorPlan(int? idPlan)
    {
        if (idPlan == null || idPlan <= 0) return 0;

        var plan = planes.FirstOrDefault(p => p.IdPlan == idPlan);
        if (plan == null) return 30; // Default por seguridad si el plan no se encuentra en la lista cargada
        
        var nombre = plan.PlanNombre?.ToLower() ?? "";
        if (nombre.Contains("clase") || nombre.Contains("dia") || nombre.Contains("día")) return 1;
        if (nombre.Contains("semana")) return 7;
        if (nombre.Contains("anual") || nombre.Contains("año")) return 365;
        if (nombre.Contains("trimestral")) return 90;
        if (nombre.Contains("semestral")) return 180;
        
        return 30; // "mensual" o default
    }

    protected override async Task OnInitializedAsync()
    {
        searchTimer = new System.Timers.Timer(400);
        searchTimer.Elapsed += async (s, e) =>
        {
            await InvokeAsync(async () =>
            {
                await LoadClients();
            });
        };
        searchTimer.AutoReset = false;

        await LoadClients();
    }

    private void HandleSearchKey(KeyboardEventArgs e)
    {
        searchTimer?.Stop();
        searchTimer?.Start();
    }

    private async Task LoadClients(bool append = false)
    {
        isLoading = true;
        if (!append)
        {
            currentPage = 0;
            clientes.Clear();
        }
        
        var newClients = await ClienteService.GetClientesAsync(searchTerm, pageSize, currentPage * pageSize);
        
        if (newClients.Any())
        {
            clientes.AddRange(newClients);
            hasMore = newClients.Count == pageSize;
        }
        else
        {
            hasMore = false;
        }

        if (!generos.Any()) generos = await ClienteService.GetGenerosAsync();
        if (!planes.Any()) planes = await ClienteService.GetPlanesAsync();
        
        isLoading = false;
        StateHasChanged();
    }

    private async Task LoadMoreClients()
    {
        currentPage++;
        await LoadClients(true);
    }

    private void ShowAddClientForm()
    {
        editingCliente = new Cliente
        {
            FechaInicio = DateTime.Now.Date,
            FechaVencimiento = DateTime.Now.Date.AddDays(30),
            Estado = 1
        };
        isRenovating = false;
        showForm = true;
    }

    private void RenovarPlan(Cliente c)
    {
        var start = c.FechaVencimiento.HasValue && c.FechaVencimiento.Value > DateTime.Now.Date 
            ? c.FechaVencimiento.Value 
            : DateTime.Now.Date;
            
        var dias = GetDiasPorPlan(c.IdPlan);

        editingCliente = new Cliente
        {
            IdCliente = c.IdCliente,
            Documento = c.Documento,
            Nombre = c.Nombre,
            Apellido = c.Apellido,
            FechaNacimiento = c.FechaNacimiento,
            IdGenero = c.IdGenero,
            Direccion = c.Direccion,
            Telefono = c.Telefono,
            Email = c.Email,
            IdPlan = c.IdPlan,
            FechaInicio = start,
            FechaVencimiento = start.AddDays(dias),
            FechaRegistro = c.FechaRegistro,
            Estado = 1,
            NotaAdicional = c.NotaAdicional,
            Huella = c.Huella,
            TipoSangre = c.TipoSangre,
            Alergias = c.Alergias,
            EnfermedadesCronicas = c.EnfermedadesCronicas,
            ContactoEmergenciaNombre = c.ContactoEmergenciaNombre,
            ContactoEmergenciaTelefono = c.ContactoEmergenciaTelefono,
            VencimientoAptoMedico = c.VencimientoAptoMedico
        };
        isRenovating = true;
        showForm = true;
    }

    private void EditClient(Cliente c)
    {
        showDetails = false;
        originalEstado = c.Estado;
        editingCliente = new Cliente
        {
            IdCliente = c.IdCliente,
            Documento = c.Documento,
            Nombre = c.Nombre,
            Apellido = c.Apellido,
            FechaNacimiento = c.FechaNacimiento,
            IdGenero = c.IdGenero,
            Direccion = c.Direccion,
            Telefono = c.Telefono,
            Email = c.Email,
            IdPlan = c.IdPlan,
            FechaInicio = c.FechaInicio,
            FechaVencimiento = c.FechaVencimiento,
            FechaRegistro = c.FechaRegistro,
            Estado = c.Estado,
            NotaAdicional = c.NotaAdicional,
            Huella = c.Huella,
            TipoSangre = c.TipoSangre,
            Alergias = c.Alergias,
            EnfermedadesCronicas = c.EnfermedadesCronicas,
            ContactoEmergenciaNombre = c.ContactoEmergenciaNombre,
            ContactoEmergenciaTelefono = c.ContactoEmergenciaTelefono,
            VencimientoAptoMedico = c.VencimientoAptoMedico
        };
        isRenovating = false;
        showForm = true;
    }

    private async Task ViewDetails(Cliente c)
    {
        selectedClient = c;
        showForm = false;
        showDetails = true;
        history = await ClienteService.GetPagosPorClienteAsync(c.IdCliente);
    }

    private async Task AnularPagoDesdeHistorial(PagoReporte p)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"¿Estás seguro de que deseas ANULAR el pago de ${p.Monto} del día {p.FechaRegistro?.ToString("dd/MM/yyyy")}? Esta acción no se puede deshacer.");
        if (confirmed)
        {
            try 
            {
                await ClienteService.AnularPagoAsync(p.IdPago);
                if (selectedClient != null)
                {
                    history = await ClienteService.GetPagosPorClienteAsync(selectedClient.IdCliente);
                }
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", ex.Message);
            }
        }
    }

    private void CloseDetails()
    {
        showDetails = false;
        selectedClient = null;
    }

    private async Task SaveClient()
    {
        try 
        {
            if (editingCliente.IdCliente == 0)
            {
                await ClienteService.AddClienteAsync(editingCliente);
            }
            else if (isRenovating || (originalEstado == 0 && editingCliente.Estado == 1))
            {
                // Si es renovación explícita O era inactivo y ahora es activo, creamos pago
                await ClienteService.RenovarClienteAsync(editingCliente);
            }
            else
            {
                await ClienteService.UpdateClienteAsync(editingCliente);
            }

            showForm = false;
            await LoadClients();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", ex.Message);
        }
    }

    private void CancelForm()
    {
        showForm = false;
    }

    private async Task ToggleEstadoClient(Cliente c)
    {
        try 
        {
            c.Estado = c.Estado == 1 ? 0 : 1;
            await ClienteService.UpdateClienteAsync(c);
            await LoadClients();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", ex.Message);
        }
    }

    private async Task DeleteClient(Cliente c)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"¿Estás completamente seguro de que deseas ELIMINAR a {c.Nombre} {c.Apellido}? Esta acción borrará al cliente de la base de datos de forma permanente.");
        if (confirmed)
        {
            try 
            {
                await ClienteService.DeleteClienteAsync(c.IdCliente);
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", ex.Message);
            }
            finally
            {
                await LoadClients();
            }
        }
    }

    public void Dispose()
    {
        searchTimer?.Dispose();
    }
}
