@page "/reports"
@using CoreAdmin.Models
@using CoreAdmin.Services
@inject ReportesService ReportesService
@inject ClienteService ClienteService
@inject AuthService AuthService
@inject PrinterService PrinterService
@inject SettingsService SettingsService
@inject IJSRuntime JS
@inject FileService FileService

<PageTitle>Reportes Financieros</PageTitle>

<div class="d-flex flex-column" style="height: calc(100vh - 120px);">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 flex-shrink-0">
        <h1 class="h3 fw-bold mb-0" style="color: var(--fedora-dark);">
            <i class="bi bi-graph-up-arrow text-primary me-2"></i> Reportes Financieros
        </h1>

        <div class="d-flex gap-2 align-items-center flex-wrap">
            <label class="text-muted fw-semibold small">Desde:</label>
            <input type="date" class="form-control form-control-sm border-0 bg-white shadow-sm"
                   style="width: 140px; border-radius: 20px; padding: 0.25rem 0.75rem;" @bind="fechaDesde" />

            <label class="text-muted fw-semibold small ms-2">Hasta:</label>
            <input type="date" class="form-control form-control-sm border-0 bg-white shadow-sm"
                   style="width: 140px; border-radius: 20px; padding: 0.25rem 0.75rem;" @bind="fechaHasta" />

            <div class="input-group input-group-sm bg-white shadow-sm ms-md-3 px-2" style="width: 250px; border-radius: 20px;">
                <span class="input-group-text bg-transparent border-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text" class="form-control border-0 bg-transparent shadow-none"
                       placeholder="Buscar cliente..."
                       @bind="searchTerm"
                       @onkeyup="HandleSearch" />
            </div>

            <button class="btn btn-sm btn-dark ms-2 shadow-sm px-4 rounded-pill" style="background-color: var(--fedora-sidebar);"
                    @onclick="() => LoadReportes()">
                <i class="bi bi-funnel me-1"></i> Filtrar
            </button>

            <button class="btn btn-sm btn-outline-success ms-2 shadow-sm px-3 rounded-pill"
                    @onclick="ExportarExcel" disabled="@isLoading">
                <i class="bi bi-file-earmark-excel me-1"></i> Exportar
            </button>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-0 flex-grow-1 d-flex flex-column overflow-hidden" style="border-radius: 12px;">
        <div class="card-body p-0 flex-grow-1 d-flex flex-column overflow-hidden">
            <div class="table-responsive flex-grow-1 custom-scrollbar">
                <table class="table table-hover align-middle mb-0 text-nowrap">
                    <thead style="background-color: #fbfbfb; position: sticky; top: 0; z-index: 10;">
                        <tr class="small text-uppercase text-muted fw-bold">
                            <th class="ps-4 py-3 border-bottom-0">Comprobante</th>
                            <th class="py-3 border-bottom-0">Cliente</th>
                            <th class="py-3 border-bottom-0">Plan</th>
                            <th class="text-end py-3 border-bottom-0">Fecha</th>
                            <th class="text-end py-3 border-bottom-0">Monto</th>
                            <th class="text-end pe-4 py-3 border-bottom-0">Acciones</th>
                        </tr>
                    </thead>

                <tbody>
                    @foreach (var p in pagos)
                    {
                        <tr>
                            <td class="ps-4 text-muted fw-medium">
                                #@p.IdPago.ToString("D5")
                            </td>

                            <td class="fw-bold" style="color: var(--fedora-dark);">
                                @p.Nombre @p.Apellido
                            </td>

                            <td>
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border-0 px-2 py-1 rounded-pill">@p.PlanNombre</span>
                            </td>

                            <td class="text-end text-muted small">
                                @(p.FechaRegistro?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                            </td>

                            <td class="text-end fw-bold" style="color: var(--fedora-blue);">
                                $@p.Monto.ToString("N2")
                            </td>

                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-icon-fedora me-1"
                                        @onclick="() => ImprimirComprobante(p)" title="Imprimir Comprobante">
                                    <i class="bi bi-printer"></i>
                                </button>
                                <button class="btn btn-sm btn-icon-fedora text-danger @(AuthService.CurrentUser?.IdRol != 0 ? "role-restricted-element" : "")" 
                                        @onclick="() => AnularComprobante(p)"
                                        disabled="@(AuthService.CurrentUser?.IdRol != 0)"
                                        title="@(AuthService.CurrentUser?.IdRol != 0 ? "Requiere permisos de Administrador" : "Anular Pago")">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            </td>
                        </tr>
                    }

                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4">
                                Cargando...
                            </td>
                        </tr>
                    }
                    else if (!pagos.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4">
                                Sin resultados
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
        @if (hasMore)
        {
            <div class="card-footer bg-white border-top py-3 text-center">
                <button class="btn btn-outline-primary btn-sm px-4" @onclick="LoadMoreReportes" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Cargando...</span>
                    }
                    else
                    {
                        <i class="bi bi-arrow-down-circle me-2"></i>
                        <span>Cargar más registros</span>
                    }
                </button>
            </div>
        }
        @if (pagos.Any())
        {
            <div class="card-footer py-3 border-0 sticky-bottom shadow-sm @(AuthService.CurrentUser?.IdRol != 0 ? "role-restricted-element" : "")" style="z-index: 5; background-color: #fbfbfb; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                <div class="d-flex justify-content-between align-items-center px-4">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-3 d-flex justify-content-center align-items-center" style="width: 40px; height: 40px;">
                            <i class="bi bi-wallet2 fs-5"></i>
                        </div>
                        <div class="lh-1">
                            <span class="text-muted fw-bold d-block mb-1">Monto Total Recaudado</span>
                            <small class="text-muted">@(AuthService.CurrentUser?.IdRol != 0 ? "Información restringida" : "En base a filtros seleccionados")</small>
                        </div>
                    </div>
                    <div class="text-end">
                        <h2 class="mb-0 fw-bold" style="color: var(--fedora-blue); letter-spacing: -1px;">@(AuthService.CurrentUser?.IdRol == 0 ? $"${TotalRecaudado:N2}" : "$ ---.--")</h2>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- TICKET -->
<div id="printable-area">
    @if (pagoAImprimir != null)
    {
        <div id="printable-receipt">
            <div class="receipt-header">
                <span class="receipt-title">COREADMIN</span>
                <p>Comprobante de Pago</p>
                <p>#@pagoAImprimir.IdPago.ToString("D5")</p>
            </div>

            <div class="receipt-row">
                <span>Fecha:</span>
                <span>@(pagoAImprimir.FechaRegistro?.ToString("dd/MM/yyyy HH:mm"))</span>
            </div>

            <div class="receipt-separator"></div>

            <div class="receipt-row">
                <span>Cliente:</span>
                <span>@pagoAImprimir.Nombre @pagoAImprimir.Apellido</span>
            </div>
            <div class="receipt-row">
                <span>ID Cliente:</span>
                <span>@pagoAImprimir.IdCliente</span>
            </div>

            <div class="receipt-separator"></div>

            <div class="receipt-row">
                <span><b>Plan:</b></span>
                <span>@pagoAImprimir.PlanNombre</span>
            </div>
            <div class="receipt-row">
                <span><b>Importe:</b></span>
                <span>$@pagoAImprimir.Monto.ToString("N2")</span>
            </div>

            <div class="receipt-separator"></div>

            <div class="total-amount">
                TOTAL: $@pagoAImprimir.Monto.ToString("N2")
            </div>

            <div class="receipt-footer">
                <p>Atendido por: @(AuthService.CurrentUser?.NombreUsuario ?? "Sistema")</p>
                <p>¡Gracias por su pago!</p>
            </div>
        </div>
    }
</div>


@code {
    private List<PagoReporte> pagos = new();
    private PagoReporte? pagoAImprimir;

    private DateTime? fechaDesde = DateTime.Now.AddDays(-30);
    private DateTime? fechaHasta = DateTime.Now;
    private string searchTerm = "";
    private bool isLoading = false;

    private decimal TotalRecaudado => pagos.Sum(p => p.Monto);

    // Paginación
    private int pageSize = 50;
    private int currentPage = 0;
    private bool hasMore = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadReportes();
    }

    private async Task HandleSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadReportes();
        }
    }

    private async Task LoadReportes(bool append = false)
    {
        isLoading = true;
        if (!append)
        {
            currentPage = 0;
            pagos.Clear();
        }

        var res = await ReportesService.GetReportePagosAsync(fechaDesde, fechaHasta, searchTerm, pageSize, currentPage * pageSize);
        
        if (res.Any())
        {
            pagos.AddRange(res);
            hasMore = res.Count == pageSize;
        }
        else
        {
            hasMore = false;
        }

        isLoading = false;
    }

    private async Task LoadMoreReportes()
    {
        currentPage++;
        await LoadReportes(true);
    }

    private async Task ImprimirComprobante(PagoReporte pago)
    {
        var settings = await SettingsService.GetPrinterSettingsAsync();
        
        if (settings.UseNetwork)
        {
            try 
            {
                await PrinterService.ImprimirPagoAsync(pago, AuthService.CurrentUser?.NombreUsuario ?? "Sistema");
                return; // Éxito, no necesitamos mostrar el ticket en pantalla
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("alert", $"Error en impresión directa: {ex.Message}. Se procederá con la impresión clásica.");
            }
        }

        pagoAImprimir = pago;
        StateHasChanged();

        // Esperar a que el DOM realmente renderice
        await Task.Delay(300);
        await JS.InvokeVoidAsync("window.print");

        pagoAImprimir = null;
        StateHasChanged();
    }

    private async Task AnularComprobante(PagoReporte pago)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"¿Estás seguro de que deseas anular el comprobante #{pago.IdPago.ToString("D5")} de {pago.Nombre} {pago.Apellido}?");
        if (confirmed)
        {
            await ClienteService.AnularPagoAsync(pago.IdPago);
            await LoadReportes();
        }
    }

    private async Task ExportarExcel()
    {
        try 
        {
            isLoading = true;
            StateHasChanged();

            // Obtener TODOS los datos filtrados (sin límite de paginación para el reporte total)
            var allData = await ReportesService.GetReportePagosAsync(fechaDesde, fechaHasta, searchTerm, 100000, 0);
            
            if (!allData.Any())
            {
                await JS.InvokeVoidAsync("alert", "No hay datos para exportar con los filtros seleccionados.");
                return;
            }

            var excelBytes = await ReportesService.GenerateExcelReportAsync(allData);
            
            string defaultFileName = $"Reporte_Financiero_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
            var savedPath = await FileService.SaveFileAsync(defaultFileName, excelBytes);

            if (!string.IsNullOrEmpty(savedPath))
            {
                await JS.InvokeVoidAsync("alert", $"Reporte exportado con éxito en: {savedPath}");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al exportar: {ex.Message}");
        }
        finally 
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
