@page "/reports"
@using CoreAdmin.Models
@using CoreAdmin.Services
@inject ReportesService ReportesService
@inject AuthService AuthService
@inject PrinterService PrinterService
@inject SettingsService SettingsService
@inject IJSRuntime JS

<PageTitle>Reportes Financieros</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h3 class="mb-0 fw-bold text-dark">
        <i class="bi bi-graph-up-arrow text-primary me-2"></i> Reportes Financieros
    </h3>

    <div class="d-flex gap-2 align-items-center flex-wrap">
        <label class="text-muted fw-semibold small">Desde:</label>
        <input type="date" class="form-control form-control-sm border shadow-sm"
               style="width: 140px;" @bind="fechaDesde" />

        <label class="text-muted fw-semibold small ms-2">Hasta:</label>
        <input type="date" class="form-control form-control-sm border shadow-sm"
               style="width: 140px;" @bind="fechaHasta" />

        <div class="input-group input-group-sm ms-md-3 shadow-sm" style="width: 250px;">
            <span class="input-group-text bg-white border-end-0">
                <i class="bi bi-search text-muted"></i>
            </span>
            <input type="text" class="form-control border-start-0 ps-0"
                   placeholder="Buscar cliente..."
                   @bind="searchTerm"
                   @onkeyup="HandleSearch" />
        </div>

        <button class="btn btn-sm btn-dark ms-2 shadow-sm px-3"
                @onclick="LoadReportes">
            <i class="bi bi-funnel me-1"></i> Filtrar
        </button>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive" style="max-height: 550px; overflow-y: auto;">
            <table class="table table-hover align-middle mb-0 text-nowrap">
                <thead class="table-light sticky-top" style="z-index: 10;">
                    <tr>
                        <th class="ps-4 py-3">Comprobante</th>
                        <th>Cliente</th>
                        <th>Plan</th>
                        <th class="text-end">Fecha</th>
                        <th class="text-end">Monto</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var p in pagos)
                    {
                        <tr>
                            <td class="ps-4">
                                #@p.IdPago.ToString("D5")
                            </td>

                            <td>
                                @p.Nombre @p.Apellido
                            </td>

                            <td>@p.PlanNombre</td>

                            <td class="text-end">
                                @(p.FechaRegistro?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                            </td>

                            <td class="text-end text-success fw-bold">
                                $@p.Monto.ToString("N2")
                            </td>

                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-outline-primary"
                                        @onclick="() => ImprimirComprobante(p)">
                                    Imprimir
                                </button>
                            </td>
                        </tr>
                    }

                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4">
                                Cargando...
                            </td>
                        </tr>
                    }
                    else if (!pagos.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4">
                                Sin resultados
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card p-3">
    <strong>Total:</strong> $@TotalRecaudado.ToString("N2")
</div>

<!-- TICKET -->
<div id="printable-area">
    @if (pagoAImprimir != null)
    {
        <div id="printable-receipt">
            <div class="receipt-header">
                <span class="receipt-title">COREADMIN</span>
                <p>Comprobante de Pago</p>
                <p>#@pagoAImprimir.IdPago.ToString("D5")</p>
            </div>

            <div class="receipt-row">
                <span>Fecha:</span>
                <span>@(pagoAImprimir.FechaRegistro?.ToString("dd/MM/yyyy HH:mm"))</span>
            </div>

            <div class="receipt-separator"></div>

            <div class="receipt-row">
                <span>Cliente:</span>
                <span>@pagoAImprimir.Nombre @pagoAImprimir.Apellido</span>
            </div>
            <div class="receipt-row">
                <span>ID Cliente:</span>
                <span>@pagoAImprimir.IdCliente</span>
            </div>

            <div class="receipt-separator"></div>

            <div class="receipt-row">
                <span><b>Plan:</b></span>
                <span>@pagoAImprimir.PlanNombre</span>
            </div>
            <div class="receipt-row">
                <span><b>Importe:</b></span>
                <span>$@pagoAImprimir.Monto.ToString("N2")</span>
            </div>

            <div class="receipt-separator"></div>

            <div class="total-amount">
                TOTAL: $@pagoAImprimir.Monto.ToString("N2")
            </div>

            <div class="receipt-footer">
                <p>Atendido por: @(AuthService.CurrentUser?.NombreUsuario ?? "Sistema")</p>
                <p>¡Gracias por su pago!</p>
            </div>
        </div>
    }
</div>


@code {
    private List<PagoReporte> pagos = new();
    private bool isLoading = true;
    private PagoReporte? pagoAImprimir;

    private DateTime? fechaDesde;
    private DateTime? fechaHasta;
    private string searchTerm = "";

    private decimal TotalRecaudado => pagos.Sum(p => p.Monto);

    protected override async Task OnInitializedAsync()
    {
        fechaDesde = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
        fechaHasta = DateTime.Now;

        await LoadReportes();
    }

    private async Task HandleSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadReportes();
        }
    }

    private async Task LoadReportes()
    {
        isLoading = true;

        pagos = await ReportesService.GetReportePagosAsync(
            fechaDesde,
            fechaHasta,
            searchTerm
        );

        isLoading = false;
    }

    private async Task ImprimirComprobante(PagoReporte pago)
    {
        var settings = await SettingsService.GetPrinterSettingsAsync();
        
        if (settings.UseNetwork)
        {
            try 
            {
                await PrinterService.ImprimirPagoAsync(pago, AuthService.CurrentUser?.NombreUsuario ?? "Sistema");
                return; // Éxito, no necesitamos mostrar el ticket en pantalla
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("alert", $"Error en impresión directa: {ex.Message}. Se procederá con la impresión clásica.");
            }
        }

        pagoAImprimir = pago;
        StateHasChanged();

        // Esperar a que el DOM realmente renderice
        await Task.Delay(300);
        await JS.InvokeVoidAsync("window.print");

        pagoAImprimir = null;
        StateHasChanged();
    }
}
