@using CoreAdmin.Services
@inject AuthService AuthService
@inject IJSRuntime JSRuntime

<div class="d-flex align-items-center justify-content-center vh-100 bg-secondary bg-opacity-10" style="margin: -1.5rem;">
    <div class="card shadow-lg border-0 rounded-4" style="max-width: 400px; width: 100%;">
        <div class="card-body p-5">
            <div class="text-center mb-4">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                    <i class="bi bi-shield-lock-fill fs-1"></i>
                </div>
                <h3 class="fw-bold mb-1">CoreAdmin</h3>
                <p class="text-muted small">Por favor, inicia sesión para continuar</p>
            </div>

            @if (showError)
            {
                <div class="alert alert-danger py-2 small d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    Usuario o contraseña incorrectos.
                </div>
            }

            <form @onsubmit="HandleLogin">
                <div class="form-floating mb-3 shadow-sm border-0 rounded-3">
                    <input type="text" class="form-control bg-light border-0" id="usernameInput" placeholder="Usuario" @bind="username" required autocomplete="username" />
                    <label for="usernameInput" class="text-muted"><i class="bi bi-person me-2"></i>Usuario</label>
                </div>
                <div class="form-floating mb-4 shadow-sm border-0 rounded-3">
                    <input type="password" class="form-control bg-light border-0" id="passwordInput" placeholder="Contraseña" @bind="password" required autocomplete="current-password" />
                    <label for="passwordInput" class="text-muted"><i class="bi bi-key me-2"></i>Contraseña</label>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-3 shadow border-0 rounded-3 fw-semibold d-flex align-items-center justify-content-center" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Autenticando...</span>
                    }
                    else
                    {
                        <span>Entrar al Sistema <i class="bi bi-box-arrow-in-right ms-2 fs-5"></i></span>
                    }
                </button>
            </form>
            
            <div class="text-center mt-4">
                <span class="text-muted small"><i class="bi bi-info-circle me-1"></i>Asegúrate de haber guardado al usuario en SQLite.</span>
            </div>
        </div>
    </div>
</div>

@code {
    private string username = "";
    private string password = "";
    private bool isLoading = false;
    private bool showError = false;

    private async Task HandleLogin()
    {
        isLoading = true;
        showError = false;
        StateHasChanged();

        var success = await AuthService.LoginAsync(username, password);

        if (!success)
        {
            showError = true;
        }

        isLoading = false;
        StateHasChanged();
    }
}
