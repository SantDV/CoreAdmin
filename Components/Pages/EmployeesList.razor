@page "/employees"
@using CoreAdmin.Models
@using CoreAdmin.Services
@inject EmpleadoService EmpleadoService
@inject AuthService AuthService
@inject IJSRuntime JSRuntime

<PageTitle>Personal y Seguridad</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Gestión de Personal</h2>
    <div class="d-flex gap-3 align-items-center">
        <button class="btn btn-primary shadow-sm text-nowrap" @onclick="ShowAddForm">
            <i class="bi bi-person-plus me-2"></i> Añadir Nuevo
        </button>
    </div>
</div>

@if (isLoading)
{
    <div class="d-flex flex-column justify-content-center align-items-center py-5" style="min-height: 50vh;">
        <div class="spinner-border text-primary opacity-75" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <h5 class="mt-4 text-muted fw-normal">Cargando personal...</h5>
    </div>
}
else if (showForm)
{
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-semibold">@(editingEmpleado.IdEmpleado == 0 ? "Añadir Nuevo Empleado/Usuario" : "Editar Empleado")</h5>
        </div>
        <div class="card-body p-4">
            <EditForm Model="@editingEmpleado" OnValidSubmit="SaveEmpleado">
                <DataAnnotationsValidator />
                
                <h6 class="text-primary mb-3">Datos Personales</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-muted small">Documento</label>
                        <InputText @bind-Value="editingEmpleado.Documento" class="form-control bg-light" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-muted small">Nombre</label>
                        <InputText @bind-Value="editingEmpleado.Nombre" class="form-control bg-light" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-semibold text-muted small">Apellido</label>
                        <InputText @bind-Value="editingEmpleado.Apellido" class="form-control bg-light" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted small">Dirección</label>
                        <InputText @bind-Value="editingEmpleado.Direccion" class="form-control bg-light" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted small">Teléfono</label>
                        <InputText @bind-Value="editingEmpleado.Telefono" class="form-control bg-light" />
                    </div>
                </div>

                <h6 class="text-primary mb-3 border-top pt-4">Cuenta de Acceso</h6>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-muted small">Usuario</label>
                        <InputText @bind-Value="editingEmpleado.NombreUsuario" class="form-control bg-light" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-muted small">Contraseña</label>
                        <InputText @bind-Value="editingEmpleado.Clave" class="form-control bg-light" type="password" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-muted small">Rol del Sistema</label>
                        <InputSelect @bind-Value="editingEmpleado.IdRol" class="form-select bg-light" required>
                            <option value="">Seleccione rol...</option>
                            <option value="0">Administrador</option>
                            <option value="1">Empleado Regular</option>
                        </InputSelect>
                    </div>

                    <div class="col-md-12 d-flex align-items-center mt-4">
                        <div class="form-check form-switch form-switch-lg ps-5">
                            <InputCheckbox @bind-Value="IsActiveBool" class="form-check-input" id="activeCheck" style="transform: scale(1.5); margin-left: -2.5em; margin-top: 0;" />
                            <label class="form-check-label ms-2" for="activeCheck">Cuenta Activa (Habilitado para Login)</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-4 border-top d-flex gap-2">
                    <button type="submit" class="btn btn-success px-4 shadow-sm">
                        <i class="bi bi-check-circle me-1"></i> Guardar
                    </button>
                    <button type="button" class="btn btn-outline-secondary px-4" @onclick="CancelForm">
                        Cancelar
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3 text-muted fw-semibold">Personal</th>
                        <th class="py-3 text-muted fw-semibold">Acceso (Usuario)</th>
                        <th class="py-3 text-muted fw-semibold">Rol</th>
                        <th class="py-3 text-muted fw-semibold">Estado</th>
                        <th class="pe-4 py-3 text-end text-muted fw-semibold">Acciones</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var e in empleados)
                    {
                        <tr>
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                        <i class="bi bi-person-badge fs-5"></i>
                                    </div>
                                    <div>
                                        <span class="fw-bold text-dark d-block">@e.Nombre @e.Apellido</span>
                                        <small class="text-muted">Doc: @(string.IsNullOrEmpty(e.Documento) ? "N/A" : e.Documento)</small>
                                    </div>
                                </div>
                            </td>
                            <td><span class="text-dark fw-semibold"><i class="bi bi-laptop me-2 text-muted"></i>@e.NombreUsuario</span></td>
                            <td>
                                @if(e.IdRol == 0)
                                {
                                    <span class="badge bg-dark fw-normal px-2 py-1"><i class="bi bi-star-fill text-warning me-1"></i> Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary opacity-75 fw-normal px-2 py-1">Empleado</span>
                                }
                            </td>
                            <td>
                                @if (e.Estado == 1)
                                {
                                    <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success fw-normal px-3 py-2">Activo</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary border border-secondary fw-normal px-3 py-2">Inactivo</span>
                                }
                            </td>
                            <td class="text-end pe-4 text-nowrap">
                                <button class="btn btn-sm btn-light text-warning me-1 border shadow-sm" @onclick="() => ToggleEstado(e)" disabled="@(AuthService.CurrentUser?.IdUsuario == e.IdUsuario)" title="@(e.Estado == 1 ? "Suspender" : "Habilitar")">
                                    <i class="bi @(e.Estado == 1 ? "bi-pause-circle" : "bi-play-circle")"></i>
                                </button>
                                <button class="btn btn-sm btn-light text-primary me-1 border shadow-sm" @onclick="() => EditEmpleado(e)" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-light text-danger border shadow-sm" @onclick="() => DeleteEmpleado(e)" disabled="@(AuthService.CurrentUser?.IdUsuario == e.IdUsuario)" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                    @if (!empleados.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">No existen registros de personal aún.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<Empleado> empleados = new();
    private bool isLoading = true;
    private bool showForm = false;
    private Empleado editingEmpleado = new();

    private bool IsActiveBool
    {
        get => editingEmpleado.Estado == 1;
        set => editingEmpleado.Estado = value ? 1 : 0;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadEmpleados();
    }

    private async Task LoadEmpleados()
    {
        isLoading = true;
        empleados = await EmpleadoService.GetEmpleadosAsync();
        isLoading = false;
    }

    private void ShowAddForm()
    {
        editingEmpleado = new Empleado
        {
            FechaRegistro = DateTime.Now,
            Estado = 1,
            IdRol = 1 // Default Empleado Regular
        };
        showForm = true;
    }

    private void EditEmpleado(Empleado e)
    {
        editingEmpleado = new Empleado
        {
            IdEmpleado = e.IdEmpleado,
            Documento = e.Documento,
            Nombre = e.Nombre,
            Apellido = e.Apellido,
            Direccion = e.Direccion,
            Telefono = e.Telefono,
            IdUsuario = e.IdUsuario,
            Estado = e.Estado,
            FechaRegistro = e.FechaRegistro,
            NombreUsuario = e.NombreUsuario,
            Clave = e.Clave,
            IdRol = e.IdRol
        };
        showForm = true;
    }

    private async Task SaveEmpleado()
    {
        try 
        {
            if (editingEmpleado.IdEmpleado == 0)
            {
                await EmpleadoService.AddEmpleadoAsync(editingEmpleado);
            }
            else
            {
                await EmpleadoService.UpdateEmpleadoAsync(editingEmpleado);
            }
            showForm = false;
            await LoadEmpleados();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", ex.Message);
        }
    }

    private void CancelForm()
    {
        showForm = false;
    }

    private async Task ToggleEstado(Empleado e)
    {
        e.Estado = e.Estado == 1 ? 0 : 1;
        await EmpleadoService.UpdateEmpleadoAsync(e);
        await LoadEmpleados();
    }

    private async Task DeleteEmpleado(Empleado e)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"¿Estás seguro de eliminar a {e.NombreUsuario}? Esto borrará la cuenta de sistema.");
        if (confirmed)
        {
            try
            {
                await EmpleadoService.DeleteEmpleadoAsync(e.IdEmpleado, e.IdUsuario);
                await LoadEmpleados();
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", ex.Message);
            }
        }
    }
}
